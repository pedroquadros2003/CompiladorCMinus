11: /* Um programa para calcular mdc 
12:    Segundo o algoritmo de Euclides*/
13: int gdc (int u, int v)
	13: reserved word: int
	13: ID, name= gdc
	13: (
	13: reserved word: int
	13: ID, name= u
	13: ,
	13: reserved word: int
	13: ID, name= v
	13: )
14: {
	14: {
15:     if (v == 0) return u;
	15: reserved word: if
	15: (
	15: ID, name= v
	15: ==
	15: NUM, val= 0
	15: )
	15: reserved word: return
	15: ID, name= u
	15: ;
16:     else return gdc(v,u-u/v*v);
	16: reserved word: else
	16: reserved word: return
	16: ID, name= gdc
	16: (
	16: ID, name= v
	16: ,
	16: ID, name= u
	16: -
	16: ID, name= u
	16: /
	16: ID, name= v
	16: *
	16: ID, name= v
	16: )
	16: ;
17:     /* u-u / v*v == u mod v */
18: }
	18: }
