int funOne(void) {
    output(1); return 1;
}

int funTwo(void) {
    output(2); return 2;
}

int funThree(void) {
    output(3); return 3;
}

/* oops, 2 functions with the same name */ 
int funTwo(void) { 
    output(4);  return 4;
}

void main(void)
{
    int a;
    a = funOne() + funTwo();
    output(a);
}
