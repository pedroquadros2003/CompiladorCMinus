/* Variaveis em blocos aninhados */
/* difere: declaracoes antes das atribuicoes */ 
void teste (int b, int a) {
  output(a);
  output(b);
  { int a;
    int b;
    a = 3;
    b = 4;
    output(a);
    output(b);
  }
  a = 5;
  output(a);
}

void main(void) {
  int a;
  int b;
  a = 1;
  b = 2;
  teste(a,b);
  output(a);
  output(b);
}
/* saida: 2 1 3 4 5 1 2 */
